rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidVoiceDisguise(val) {
      return val in ['NONE', 'DEEP', 'STUDIO_RADIO', 'GLITCH', 'NEUTRAL_SHIFT', 'MASKED', 'HIGH'];
    }

    function isValidDebateStance(val) {
      return val in ['NONE', 'AGREE', 'DISAGREE'];
    }

    // --- VALIDATION BLUEPRINTS ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 30 &&
             data.accentKey is string && data.accentKey.size() >= 1 && data.accentKey.size() <= 30 &&
             data.bannerKey is string && data.bannerKey.size() >= 1 && data.bannerKey.size() <= 30 &&
             data.waveformStyle is string && data.waveformStyle.size() >= 1 && data.waveformStyle.size() <= 30 &&
             data.visibility == 'PUBLIC' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             (!('avatarBase64' in data) || (data.avatarBase64 is string && data.avatarBase64.size() <= 220000)) &&
             (!('voiceBioAudioUrl' in data) || (data.voiceBioAudioUrl is string && data.voiceBioAudioUrl.size() <= 2048)) &&
             (!('voiceBioMediaId' in data) || (data.voiceBioMediaId is string && data.voiceBioMediaId.size() <= 2048)) &&
             (!('voiceBioTranscript' in data) || (data.voiceBioTranscript is string && data.voiceBioTranscript.size() <= 600)) &&
             (!('voiceBioDurationMs' in data) || (data.voiceBioDurationMs is int && data.voiceBioDurationMs >= 0 && data.voiceBioDurationMs <= 60000)) &&
             (!('voiceBioPeaks' in data) || (data.voiceBioPeaks is list && data.voiceBioPeaks.size() <= 64 && (data.voiceBioPeaks.size() == 0 || data.voiceBioPeaks[0] is number))) &&
             (!('interests' in data) || (data.interests is list && data.interests.size() <= 12 && (data.interests.size() == 0 || data.interests[0] is string))) &&
             (!('followerCount' in data) || (data.followerCount is int && data.followerCount >= 0)) &&
             (!('followingCount' in data) || (data.followingCount is int && data.followingCount >= 0));
    }

    function isValidUserReaction(data) {
      return data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 &&
             data.vote in ['NONE', 'LIKE', 'DISLIKE'] &&
             data.echoed is bool &&
             data.bookmarked is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidJoinedRoom(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             isValidTimestamp(data.joinedAt) &&
             (!('anonymousAlias' in data) || (data.anonymousAlias is string && data.anonymousAlias.size() <= 40));
    }

    function isValidUserFollow(data) {
      return data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSafetySettings(data) {
      return data.showUnfilteredControversial is bool &&
             data.collapseHeavilyDownvoted is bool &&
             data.downvoteThreshold is int && data.downvoteThreshold >= 1 && data.downvoteThreshold <= 100 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSafetyRelation(data) {
      return data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             data.relationType in ['MUTE', 'BLOCK'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt) &&
             (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 80));
    }

    function isValidAudioBlob(data) {
      return data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.audioBase64 is string && data.audioBase64.size() >= 1 && data.audioBase64.size() <= 850000 &&
             data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 64 &&
             data.durationMs is int && data.durationMs >= 100 && data.durationMs <= 120000 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidRoom(data) {
      return data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 32 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.anonymousRoom is bool &&
             data.accentKey is string && data.accentKey.size() >= 1 && data.accentKey.size() <= 30 &&
             data.creatorUid is string && data.creatorUid.size() >= 1 && data.creatorUid.size() <= 128 &&
             data.memberCount is int && data.memberCount >= 0 &&
             data.postCount is int && data.postCount >= 0 &&
             data.visibility == 'PUBLIC' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt) &&
             (!('guidelines' in data) || (data.guidelines is string && data.guidelines.size() <= 400));
    }

    function isValidPost(data) {
      return data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorHandle is string && data.authorHandle.size() >= 1 && data.authorHandle.size() <= 40 &&
             data.postKind in ['FEED_VOICE', 'PULSE_SHORT', 'VOICE_DROP'] &&
             data.anonymousMode is bool &&
             isValidVoiceDisguise(data.voiceDisguise) &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 120000 &&
             data.waveformPeaks is list && data.waveformPeaks.size() <= 64 &&
             (data.waveformPeaks.size() == 0 || data.waveformPeaks[0] is number) &&
             data.transcript is string && data.transcript.size() <= 4000 &&
             data.captionSegments is list && data.captionSegments.size() <= 80 &&
             (data.captionSegments.size() == 0 || data.captionSegments[0] is map) &&
             data.likeCount is int && data.likeCount >= 0 &&
             data.dislikeCount is int && data.dislikeCount >= 0 &&
             data.commentCount is int && data.commentCount >= 0 &&
             data.echoCount is int && data.echoCount >= 0 &&
             data.visibility == 'PUBLIC' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt) &&
             (!('authorAccentKey' in data) || (data.authorAccentKey is string && data.authorAccentKey.size() <= 30)) &&
             (!('authorAvatarBase64' in data) || (data.authorAvatarBase64 is string && data.authorAvatarBase64.size() <= 220000)) &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
             (!('roomSlug' in data) || (data.roomSlug is string && data.roomSlug.size() <= 40)) &&
             (!('anonymousAlias' in data) || (data.anonymousAlias is string && data.anonymousAlias.size() <= 40)) &&
             (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2048)) &&
             (!('audioMediaId' in data) || (data.audioMediaId is string && data.audioMediaId.size() <= 2048)) &&
             (!('headlineText' in data) || (data.headlineText is string && data.headlineText.size() <= 280)) &&
             (!('attachmentImageBase64' in data) || (data.attachmentImageBase64 is string && data.attachmentImageBase64.size() <= 260000)) &&
             (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 10 && (data.hashtags.size() == 0 || data.hashtags[0] is string))) &&
             (!('expiresAtMs' in data) || (data.expiresAtMs is int && data.expiresAtMs >= 0)) &&
             (!('hotTakeMode' in data) || data.hotTakeMode is bool) &&
             (!('agreeCount' in data) || (data.agreeCount is int && data.agreeCount >= 0)) &&
             (!('disagreeCount' in data) || (data.disagreeCount is int && data.disagreeCount >= 0)) &&
             (!('quotedPostId' in data) || (data.quotedPostId is string && data.quotedPostId.size() <= 128)) &&
             (!('quotedAuthorName' in data) || (data.quotedAuthorName is string && data.quotedAuthorName.size() <= 60)) &&
             (!('quotedAudioUrl' in data) || (data.quotedAudioUrl is string && data.quotedAudioUrl.size() <= 2048)) &&
             (!('quotedAudioMediaId' in data) || (data.quotedAudioMediaId is string && data.quotedAudioMediaId.size() <= 2048)) &&
             (!('quotedStartMs' in data) || (data.quotedStartMs is int && data.quotedStartMs >= 0 && data.quotedStartMs <= 120000)) &&
             (!('quotedEndMs' in data) || (data.quotedEndMs is int && data.quotedEndMs >= 0 && data.quotedEndMs <= 120000)) &&
             (!('quotedDisguise' in data) || isValidVoiceDisguise(data.quotedDisguise)) &&
             (!('quotedTranscript' in data) || (data.quotedTranscript is string && data.quotedTranscript.size() <= 600)) &&
             (!('quotedWaveformPeaks' in data) || (data.quotedWaveformPeaks is list && data.quotedWaveformPeaks.size() <= 64 && (data.quotedWaveformPeaks.size() == 0 || data.quotedWaveformPeaks[0] is number))) &&
             (!('engagementScore' in data) || (data.engagementScore is int && data.engagementScore >= 0)) &&
             (!('controversyScore' in data) || (data.controversyScore is int && data.controversyScore >= 0)) &&
             (!('isShortPulse' in data) || data.isShortPulse is bool) &&
             (!('isAnonymous' in data) || data.isAnonymous is bool) &&
             (!('searchTokens' in data) || (data.searchTokens is list && data.searchTokens.size() <= 30 && (data.searchTokens.size() == 0 || data.searchTokens[0] is string)));
    }

    function isValidComment(data) {
      return data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorHandle is string && data.authorHandle.size() >= 1 && data.authorHandle.size() <= 40 &&
             data.anonymousMode is bool &&
             isValidVoiceDisguise(data.voiceDisguise) &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 120000 &&
             data.waveformPeaks is list && data.waveformPeaks.size() <= 64 &&
             (data.waveformPeaks.size() == 0 || data.waveformPeaks[0] is number) &&
             data.likeCount is int && data.likeCount >= 0 &&
             data.dislikeCount is int && data.dislikeCount >= 0 &&
             data.visibility == 'PUBLIC' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt) &&
             (!('anonymousAlias' in data) || (data.anonymousAlias is string && data.anonymousAlias.size() <= 40)) &&
             (!('stance' in data) || isValidDebateStance(data.stance)) &&
             (!('textBody' in data) || (data.textBody is string && data.textBody.size() <= 1000)) &&
             (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2048)) &&
             (!('audioMediaId' in data) || (data.audioMediaId is string && data.audioMediaId.size() <= 2048)) &&
             (!('transcript' in data) || (data.transcript is string && data.transcript.size() <= 2000)) &&
             (!('captionSegments' in data) || (data.captionSegments is list && data.captionSegments.size() <= 50 && (data.captionSegments.size() == 0 || data.captionSegments[0] is map)));
    }

    function isValidConversation(data) {
      return data.participantUids is list && data.participantUids.size() == 2 &&
             data.participantUids[0] is string && data.participantUids[1] is string &&
             data.participantNames is map &&
             data.participantHandles is map &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 200 &&
             data.lastMessageKind in ['VOICE', 'TEXT', 'IMAGE'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDirectMessage(data) {
      return data.conversationId is string && data.conversationId.size() >= 1 && data.conversationId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             data.participantUids[0] is string && data.participantUids[1] is string &&
             data.messageKind in ['VOICE', 'TEXT', 'IMAGE'] &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 120000 &&
             data.waveformPeaks is list && data.waveformPeaks.size() <= 64 &&
             (data.waveformPeaks.size() == 0 || data.waveformPeaks[0] is number) &&
             isValidTimestamp(data.createdAt) &&
             (!('textBody' in data) || (data.textBody is string && data.textBody.size() <= 2000)) &&
             (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2048)) &&
             (!('audioBase64' in data) || (data.audioBase64 is string && data.audioBase64.size() <= 650000)) &&
             (!('transcript' in data) || (data.transcript is string && data.transcript.size() <= 2000)) &&
             (!('captionSegments' in data) || (data.captionSegments is list && data.captionSegments.size() <= 50 && (data.captionSegments.size() == 0 || data.captionSegments[0] is map))) &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 260000));
    }

    function isValidReportCategory(val) {
      return val in ['CSAM_EXPLOITATION', 'VIOLENCE_THREATS', 'DOXXING_PRIVACY', 'SELF_HARM_TERRORISM', 'ILLEGAL_GOODS_FRAUD', 'HARASSMENT_HATE', 'OTHER'];
    }

    function isValidReport(data) {
      return data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 &&
             data.targetType in ['POST', 'COMMENT', 'ROOM', 'USER'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
             isValidTimestamp(data.createdAt) &&
             (!('category' in data) || isValidReportCategory(data.category)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 1000)) &&
             (!('targetAuthorUid' in data) || (data.targetAuthorUid is string && data.targetAuthorUid.size() <= 128)) &&
             (!('urgentLegalReview' in data) || data.urgentLegalReview is bool);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.visibility == 'PUBLIC';

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'handle', 'accentKey', 'bannerKey', 'waveformStyle', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'handle', 'bio', 'accentKey', 'bannerKey', 'waveformStyle', 'avatarBase64', 'voiceBioAudioUrl', 'voiceBioMediaId', 'voiceBioTranscript', 'voiceBioDurationMs', 'voiceBioPeaks', 'interests', 'followerCount', 'followingCount', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'bio', 'accentKey', 'bannerKey', 'waveformStyle', 'avatarBase64', 'voiceBioAudioUrl', 'voiceBioMediaId', 'voiceBioTranscript', 'voiceBioDurationMs', 'voiceBioPeaks', 'interests', 'followerCount', 'followingCount', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /reactions/{postId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(postId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(postId) &&
                         request.auth.uid == userId &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'vote', 'echoed', 'bookmarked', 'updatedAt']) &&
                         incoming().keys().hasOnly(['postId', 'vote', 'echoed', 'bookmarked', 'updatedAt']) &&
                         isValidUserReaction(incoming());
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(postId) &&
                         isValidUserReaction(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().postId == existing().postId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['vote', 'echoed', 'bookmarked', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(postId) && request.auth.uid == userId;
      }

      match /joined_rooms/{roomId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(roomId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(roomId) &&
                         request.auth.uid == userId &&
                         incoming().roomId == roomId &&
                         incoming().keys().hasAll(['roomId', 'joinedAt']) &&
                         incoming().keys().hasOnly(['roomId', 'anonymousAlias', 'joinedAt']) &&
                         isValidJoinedRoom(incoming());
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(roomId) &&
                         isValidJoinedRoom(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().joinedAt == existing().joinedAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['anonymousAlias']);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(roomId) && request.auth.uid == userId;
      }

      match /following/{targetUid} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(targetUid) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(targetUid) &&
                         request.auth.uid == userId &&
                         incoming().targetUid == targetUid &&
                         incoming().keys().hasAll(['targetUid', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetUid', 'createdAt']) &&
                         isValidUserFollow(incoming());
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(targetUid) && request.auth.uid == userId;
      }

      match /safety_settings/{settingId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(settingId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(settingId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['showUnfilteredControversial', 'collapseHeavilyDownvoted', 'downvoteThreshold', 'updatedAt']) &&
                         incoming().keys().hasOnly(['showUnfilteredControversial', 'collapseHeavilyDownvoted', 'downvoteThreshold', 'updatedAt']) &&
                         isValidSafetySettings(incoming());
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(settingId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasOnly(['showUnfilteredControversial', 'collapseHeavilyDownvoted', 'downvoteThreshold', 'updatedAt']) &&
                         isValidSafetySettings(incoming());
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(settingId) && request.auth.uid == userId;
      }

      match /safety_relations/{targetUid} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(targetUid) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(targetUid) &&
                         request.auth.uid == userId &&
                         incoming().targetUid == targetUid &&
                         incoming().keys().hasAll(['targetUid', 'relationType', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['targetUid', 'targetName', 'relationType', 'createdAt', 'updatedAt']) &&
                         isValidSafetyRelation(incoming());
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(targetUid) &&
                         request.auth.uid == userId &&
                         incoming().targetUid == existing().targetUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly(['targetUid', 'targetName', 'relationType', 'createdAt', 'updatedAt']) &&
                         isValidSafetyRelation(incoming());
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(targetUid) && request.auth.uid == userId;
      }
    }

    match /audio_blobs/{blobId} {
      allow get: if isSignedIn() && isValidId(blobId);
      allow create: if isSignedIn() &&
                       isValidId(blobId) &&
                       incoming().authorUid == request.auth.uid &&
                       incoming().keys().hasAll(['authorUid', 'audioBase64', 'mimeType', 'durationMs', 'createdAt']) &&
                       incoming().keys().hasOnly(['authorUid', 'audioBase64', 'mimeType', 'durationMs', 'createdAt']) &&
                       isValidAudioBlob(incoming());
      allow delete: if isSignedIn() && isValidId(blobId) && existing().authorUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && resource.data.visibility == 'PUBLIC';

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().creatorUid == request.auth.uid &&
                       incoming().keys().hasAll(['slug', 'name', 'description', 'category', 'anonymousRoom', 'accentKey', 'creatorUid', 'memberCount', 'postCount', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['slug', 'name', 'description', 'category', 'anonymousRoom', 'accentKey', 'guidelines', 'creatorUid', 'memberCount', 'postCount', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().creatorUid == existing().creatorUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().anonymousRoom == existing().anonymousRoom &&
                       (
                         // Action 1: Creator updates room details
                         (existing().creatorUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'guidelines', 'accentKey', 'updatedAt'])) ||
                         // Action 2: Community member/post counter increment/decrement
                         (incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'postCount', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().creatorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn() && (resource.data.visibility == 'PUBLIC' || resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorUid == request.auth.uid &&
                       incoming().keys().hasAll(['authorUid', 'authorName', 'authorHandle', 'postKind', 'anonymousMode', 'voiceDisguise', 'durationMs', 'waveformPeaks', 'transcript', 'captionSegments', 'likeCount', 'dislikeCount', 'commentCount', 'echoCount', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['authorUid', 'authorName', 'authorHandle', 'authorAccentKey', 'authorAvatarBase64', 'postKind', 'roomId', 'roomSlug', 'anonymousMode', 'anonymousAlias', 'voiceDisguise', 'audioUrl', 'audioMediaId', 'durationMs', 'waveformPeaks', 'transcript', 'captionSegments', 'headlineText', 'attachmentImageBase64', 'hashtags', 'likeCount', 'dislikeCount', 'commentCount', 'echoCount', 'engagementScore', 'controversyScore', 'searchTokens', 'isShortPulse', 'isAnonymous', 'hotTakeMode', 'agreeCount', 'disagreeCount', 'quotedPostId', 'quotedAuthorName', 'quotedAudioUrl', 'quotedAudioMediaId', 'quotedStartMs', 'quotedEndMs', 'quotedDisguise', 'quotedTranscript', 'quotedWaveformPeaks', 'expiresAtMs', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().authorUid == existing().authorUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().postKind == existing().postKind &&
                       (
                         // Action 1: Author edits text/transcript
                         (existing().authorUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['headlineText', 'transcript', 'captionSegments', 'updatedAt'])) ||
                         // Action 2: Engagement & Hot Take debate counter updates
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likeCount', 'dislikeCount', 'commentCount', 'echoCount', 'agreeCount', 'disagreeCount', 'engagementScore', 'controversyScore', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && resource.data.visibility == 'PUBLIC';

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'authorUid', 'authorName', 'authorHandle', 'anonymousMode', 'voiceDisguise', 'durationMs', 'waveformPeaks', 'likeCount', 'dislikeCount', 'visibility', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['postId', 'authorUid', 'authorName', 'authorHandle', 'anonymousMode', 'anonymousAlias', 'voiceDisguise', 'stance', 'textBody', 'audioUrl', 'audioMediaId', 'durationMs', 'waveformPeaks', 'transcript', 'captionSegments', 'likeCount', 'dislikeCount', 'visibility', 'createdAt', 'updatedAt']) &&
                         isValidComment(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId));

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidComment(incoming()) &&
                         incoming().authorUid == existing().authorUid &&
                         incoming().postId == existing().postId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (existing().authorUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['textBody', 'transcript', 'updatedAt'])) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['likeCount', 'dislikeCount', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && existing().authorUid == request.auth.uid;
      }
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasAll(['participantUids', 'participantNames', 'participantHandles', 'lastMessagePreview', 'lastMessageKind', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['participantUids', 'participantNames', 'participantHandles', 'lastMessagePreview', 'lastMessageKind', 'createdAt', 'updatedAt']) &&
                       isValidConversation(incoming());

      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in existing().participantUids &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'lastMessageKind', 'participantNames', 'participantHandles', 'updatedAt']);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && request.auth.uid in existing().participantUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

        allow create: if isSignedIn() &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().conversationId == conversationId &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().keys().hasAll(['conversationId', 'senderUid', 'senderName', 'participantUids', 'messageKind', 'durationMs', 'waveformPeaks', 'createdAt']) &&
                         incoming().keys().hasOnly(['conversationId', 'senderUid', 'senderName', 'participantUids', 'messageKind', 'textBody', 'audioUrl', 'audioBase64', 'durationMs', 'waveformPeaks', 'transcript', 'captionSegments', 'imageBase64', 'createdAt']) &&
                         isValidDirectMessage(incoming()) &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        allow delete: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && existing().senderUid == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().reporterUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().keys().hasAll(['reporterUid', 'targetType', 'targetId', 'reason', 'createdAt']) &&
                       incoming().keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'category', 'reason', 'details', 'targetAuthorUid', 'urgentLegalReview', 'createdAt']) &&
                       isValidReport(incoming());
    }
  }
}
